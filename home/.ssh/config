# Workaround for environments that prohibit outbound 22 SSH
Host github.com
    User git
    Hostname ssh.github.com
    Port 443

Host github-personal
    User git
    HostName ssh.github.com
    Port 443
    ForwardAgent yes
    IdentityFile ~/ssh_keys/shiroyama_macbook.key
    IdentitiesOnly yes
    AddKeysToAgent yes

Host www.shiroyama.us
    User shiroyama
    Hostname www.shiroyama.us
    Port 443

Host 192.168.22.200
    User shiroyama
    Hostname 192.168.22.200
    Port 443

Host ds224plus
    HostName 192.168.11.200
    User shiroyama
    SetEnv TERM=xterm-256color
    ForwardAgent yes
